# Exemples fictifs uniquement. Copiez ce fichier en .env et remplacez les
# valeurs localement. Ne commitez jamais .env ni de vraie clé.

# ── Base de données (PostgreSQL : locale, Supabase ou autre) ─────────────────
# Supabase : Project Settings > Database > Connection string (« Session
# pooler », port 5432). Le mot de passe est celui de la base, pas une clé API.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/simdouane_dev
# Facultatif : chemin du certificat CA du serveur (Supabase : Database
# Settings > SSL Configuration > Download certificate). Active TLS vérifié.
# Dans ce cas, ne mettez pas `sslmode=` dans DATABASE_URL.
DATABASE_SSL_CA_FILE=

# ── Supabase : comptes (Supabase Auth) et fichiers privés ───────────────────
# Adresse du projet (Project Settings > API), ex. https://xxxx.supabase.co
SUPABASE_URL=
# Clé service_role = SERVEUR UNIQUEMENT (jamais VITE_, jamais le navigateur).
# Sert à vérifier les comptes et à accéder au stockage privé.
SUPABASE_SERVICE_ROLE_KEY=
# Navigateur : la même adresse et la clé PUBLIQUE (sb_publishable_… ou anon).
# Elle ne sert qu'à la connexion : les tables et les fichiers lui sont fermés.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Stockage privé des fichiers (justificatifs, documents) ──────────────────
# Développement : local (fichiers fictifs uniquement). Production : supabase.
STORAGE_DRIVER=local
# local : dossier des fichiers (hors dépôt) et secret de signature des liens.
FILE_STORAGE_DIR=.data/files
FILE_URL_SIGNING_SECRET=
# supabase : utilise SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY ci-dessus.
# Bucket privé créé par : pnpm --filter @workspace/scripts run storage-setup
SUPABASE_STORAGE_BUCKET=simdouane-private
# Taille maximale d'un fichier en octets (défaut 10 Mo).
# MAX_UPLOAD_BYTES=10485760

# ── Administration ───────────────────────────────────────────────────────────
# Emails autorisés sur /api/admin (contrôle serveur) et liens « Administration »
# (affichage). Liste séparée par des virgules. Par défaut : l'admin historique.
# L'adresse doit aussi être CONFIRMÉE dans Supabase Auth pour obtenir les droits.
ADMIN_EMAILS=
VITE_ADMIN_EMAILS=

# ── Serveur ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Production : autres origines autorisées à appeler l'API (séparées par des
# virgules). Vide = même origine uniquement.
CORS_ORIGINS=
# Production : dossier du frontend compilé à servir par l'API (un seul
# processus Node pour tout le site). Vide = l'API ne sert que /api.
WEB_DIST_DIR=

# ── Développement local ──────────────────────────────────────────────────────
# Cible du proxy /api de Vite ; ports facultatifs (par défaut 5173 et 8080).
VITE_API_TARGET=http://127.0.0.1:8080
# WEB_PORT=5173
# API_PORT=8080

# ── Tests ────────────────────────────────────────────────────────────────────
# Base JETABLE vidée par les tests d'API. Jamais une base avec des données.
# TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/simdouane_test
